  "checks": [
    {
      "name": "Native bid review, invalid amount, refresh and durable asynchronous task focus",
      "kind": "acceptance",
      "timeout": 300,
      "assertions": [
        "BID_REVIEW_REFRESH",
        "BID_AMOUNT_INVALID",
        "BID_HELD_PENDING_FOCUS",
        "BID_ACCEPTED_TASK_FOCUS",
        "BID_ESCAPE_RETURN",
        "BID_UNCONFIRMED_TASK_FOCUS",
        "BID_ORIGINAL_UUID_RECOVERY"
      ],
      "baseline_failures": [
        "BID_REVIEW_REFRESH",
        "BID_AMOUNT_INVALID",
        "BID_HELD_PENDING_FOCUS",
        "BID_ACCEPTED_TASK_FOCUS",
        "BID_ESCAPE_RETURN",
        "BID_UNCONFIRMED_TASK_FOCUS",
        "BID_ORIGINAL_UUID_RECOVERY"
      ]
    },
    {
      "name": "Actual staff name validation, edited lot and saved-preview explanation",
      "kind": "acceptance",
      "timeout": 240,
      "assertions": [
        "ADMIN_EDITED_LOT_CURRENT",
        "ADMIN_UNSAVED_PREVIEW_HELP",
        "ADMIN_CREATE_NAME_ERROR",
        "ADMIN_CREATE_ERROR_CLEARS"
      ],
      "baseline_failures": [
        "ADMIN_EDITED_LOT_CURRENT",
        "ADMIN_UNSAVED_PREVIEW_HELP",
        "ADMIN_CREATE_NAME_ERROR",
        "ADMIN_CREATE_ERROR_CLEARS"
      ]
    },
    {
      "name": "Truthful Event information and compact native complete amount geometry",
      "kind": "acceptance",
      "timeout": 240,
      "assertions": [
        "EVENT_INFORMATION_AUTHORITY",
        "COMPACT_NATIVE_AMOUNT_WATCH"
      ],
      "baseline_failures": [
        "EVENT_INFORMATION_AUTHORITY",
        "COMPACT_NATIVE_AMOUNT_WATCH"
      ]
    },
    {
      "name": "Unavailable actions and outer small-phone review footer reachability",
      "kind": "adversarial",
      "timeout": 180,
      "assertions": [
        "RESERVED_ACTIONS_DISABLED",
        "SMALL_PHONE_OUTER_SCROLL_FOOTER"
      ],
      "baseline_failures": []
    }
  ]
}
