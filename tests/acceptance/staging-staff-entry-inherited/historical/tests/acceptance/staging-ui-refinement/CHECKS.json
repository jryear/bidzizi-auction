    "tests/acceptance/staging-workspace-entry/seed-people.sql",
    "tests/acceptance/staging-manual-bid/fixtures.mjs",
    "tests/acceptance/staging-manual-bid/protocol.mjs",
    "migrations/001_staging_staff.sql",
